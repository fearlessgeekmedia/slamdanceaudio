{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Slamdance Audio",
  "version": "0.1.0-beta",
  "identifier": "media.fearlessgeek.slamdanceaudio",
  "build": {
    "beforeBuildCommand": "node scripts/stage-web.mjs",
    "frontendDist": "../build/web"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Slamdance Audio",
        "width": 1280,
        "height": 860,
        "minWidth": 720,
        "minHeight": 540,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Music",
    "shortDescription": "Offline-first music player",
    "longDescription": "Slamdance Audio is an offline-first, themeable music player for people who care about the music.",
    "linux": {
      "appimage": {
        "bundleMediaFramework": false
      },
      "deb": {
        "depends": [
          "gstreamer1.0-plugins-base",
          "gstreamer1.0-plugins-good",
          "gstreamer1.0-plugins-bad",
          "gstreamer1.0-plugins-ugly",
          "gstreamer1.0-libav"
        ]
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
